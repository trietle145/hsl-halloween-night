    <worksheet name='Terminal map'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#52514e' fontsize='11'>change after midnight, per terminal</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hsl_reliability' name='federated.0clfoe10l09mda16yrrrf0do9cvz' />
          </datasources>
          <mapsources>
            <mapsource name='Tableau' />
          </mapsources>
          <datasource-dependencies datasource='federated.0clfoe10l09mda16yrrrf0do9cvz'>
            <column caption='Late Halloween' datatype='real' default-format='p0%' name='[Calculation_1798316175728644]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [feed] = &quot;halloween&quot; THEN [n_late] END) / SUM(IF [feed] = &quot;halloween&quot; THEN [n_observed] END)' />
            </column>
            <column caption='Late Ordinary' datatype='real' default-format='p0%' name='[Calculation_1798316175843333]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM(IF [feed] = &quot;baseline&quot; THEN [n_late] END) / SUM(IF [feed] = &quot;baseline&quot; THEN [n_observed] END)' />
            </column>
