    <worksheet name='Late by hour'>
      <layout-options>
        <title>
          <formatted-text>
            <run fontcolor='#52514e' fontsize='11'>bus departures &gt; 3 min late, by hour</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='hsl_reliability' name='federated.0clfoe10l09mda16yrrrf0do9cvz' />
          </datasources>
          <datasource-dependencies datasource='federated.0clfoe10l09mda16yrrrf0do9cvz'>
            <column caption='Saturday' datatype='string' name='[Calculation_1798316175532034]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [feed] = &quot;halloween&quot; THEN &quot;Halloween · 31 Oct&quot; ELSE &quot;Ordinary Saturday · 17 Oct&quot; END' />
            </column>
            <column caption='% LATE' datatype='real' default-format='p0%' name='[Calculation_1798316175581187]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM([n_late]) / SUM([n_observed])' />
            </column>
            <column caption='Feed' datatype='string' name='[feed]' role='dimension' type='nominal' />
            <column caption='Mode Group' datatype='string' name='[mode_group]' role='dimension' type='nominal' />
            <column caption='N Late' datatype='integer' name='[n_late]' role='measure' type='quantitative' />
            <column caption='N Observed' datatype='integer' name='[n_observed]' role='measure' type='quantitative' />
            <column-instance column='[Calculation_1798316175532034]' derivation='None' name='[none:Calculation_1798316175532034:nk]' pivot='key' type='nominal' />
            <column-instance column='[mode_group]' derivation='None' name='[none:mode_group:nk]' pivot='key' type='nominal' />
            <column-instance column='[window_time]' derivation='None' name='[none:window_time:qk]' pivot='key' type='quantitative' />
            <column-instance column='[n_observed]' derivation='Sum' name='[sum:n_observed:qk]' pivot='key' type='quantitative' />
            <column caption='Terminal Id' datatype='integer' name='[terminal_id]' role='dimension' type='ordinal' />
            <column-instance column='[Calculation_1798316175581187]' derivation='User' name='[usr:Calculation_1798316175581187:qk]' pivot='key' type='quantitative' />
            <column caption='Window Time' datatype='datetime' name='[window_time]' role='dimension' type='ordinal' />
          </datasource-dependencies>
          <filter class='categorical' column='[federated.0clfoe10l09mda16yrrrf0do9cvz].[Action (Terminal Id)]'>
            <groupfilter function='level-members' level='[terminal_id]' user:ui-action-filter='[Action2_2F91D1F3A8A049ADA5252E5E81721EDA]' user:ui-enumeration='all' user:ui-marker='enumerate' />
          </filter>
