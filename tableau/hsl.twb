      <column caption='Saturday' datatype='string' name='[Calculation_1798316175532034]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [feed] = &quot;halloween&quot; THEN &quot;Halloween · 31 Oct&quot; ELSE &quot;Ordinary Saturday · 17 Oct&quot; END' />
      </column>
      <column caption='% LATE' datatype='real' default-format='p0%' name='[Calculation_1798316175581187]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([n_late]) / SUM([n_observed])' />
      </column>
      <column caption='Late Halloween' datatype='real' default-format='p0%' name='[Calculation_1798316175728644]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feed] = &quot;halloween&quot; THEN [n_late] END) / SUM(IF [feed] = &quot;halloween&quot; THEN [n_observed] END)' />
      </column>
      <column caption='Late Ordinary' datatype='real' default-format='p0%' name='[Calculation_1798316175843333]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feed] = &quot;baseline&quot; THEN [n_late] END) / SUM(IF [feed] = &quot;baseline&quot; THEN [n_observed] END)' />
      </column>
      <column caption='Change (pp)' datatype='real' default-format='*+0.0&quot; pp&quot;;-0.0&quot; pp&quot;;0&quot; pp&quot;' name='[Calculation_1798316175949830]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='([Calculation_1798316175728644] - [Calculation_1798316175843333]) * 100' />
      </column>
      <column caption='Enough Data' datatype='boolean' name='[Calculation_1798316176113671]' role='measure' type='nominal'>
        <calculation class='tableau' formula='SUM(IF [feed] = &quot;halloween&quot; THEN [n_observed] END) &gt;= 30&#13;&#10;AND SUM(IF [feed] = &quot;baseline&quot; THEN [n_observed] END) &gt;= 30' />
      </column>
      <column caption='Coverage Halloween' datatype='real' default-format='p0%' name='[Calculation_1798316176187400]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feed] = &quot;halloween&quot; THEN [n_observed] END) / SUM(IF [feed] = &quot;halloween&quot; THEN [n_planned] END)' />
      </column>
      <column caption='Coverage Ordinary' datatype='real' default-format='p0%' name='[Calculation_1798316176240649]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM(IF [feed] = &quot;baseline&quot; THEN [n_observed] END) / SUM(IF [feed] = &quot;baseline&quot; THEN [n_planned] END)' />
      </column>
